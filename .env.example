# Visitor-facing text
SITE_NAME="Gloopix Lite"
SITE_DESCRIPTION="只属于你的 AI 生图工作台"

# Required access protection. Use different, long random values.
ACCESS_PASSWORD="replace-with-your-access-password"
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Optional for Node.js: persisted password-change file (default: .data/access-password.json)
ACCESS_PASSWORD_STORE_FILE=".data/access-password.json"

# Required server-only image API configuration
IMAGE_API_KEY=""
IMAGE_API_BASE_URL="https://api.openai.com/v1"
IMAGE_API_PROTOCOL="openai"
IMAGE_MODEL="gpt-image-2"

# OpenAI Images-compatible or APIMart image-generation endpoint paths
IMAGE_API_GENERATIONS_PATH="/images/generations"
IMAGE_API_EDITS_PATH="/images/edits"

# Provider-specific size values sent upstream
IMAGE_SIZE_SQUARE="1024x1024"
IMAGE_SIZE_LANDSCAPE="1536x1024"
IMAGE_SIZE_PORTRAIT="1024x1536"
